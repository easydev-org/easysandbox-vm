# The image every bake runs in.
#
# WHY THIS EXISTS
#
# Each bake used to install qemu with apt on a GitHub runner. That install took
# 36 seconds once and 374 seconds another time, for the same commit with no change
# in the command - the difference is entirely which mirror answered, and under
# -qq the slow case prints nothing at all and reads as a deadlock. Three rounds of
# diagnosis went the wrong way because of it.
#
# qemux/qemu already carries everything the harness needs, and Containerfile line
# 43 builds the PRODUCTION image FROM it - so this is not a new dependency, it is
# the same base the product uses, with CI no longer diverging from it.
#
# Measured, not assumed: .github/workflows/probe-qemu-image.yml ran against
# qemux/qemu:7.50 and found
#
#   qemu-system-x86_64 11.1.0     qemu-img 11.1.0
#   7z 25.01                      xorriso 1.5.6
#   curl wget python3 jq mkfifo timeout setsid unshare   all present
#   /dev/kvm usable               screendump -> a real PPM framebuffer
#   -nographic still puts the serial port on stdio
#   virt-cat                     MISSING
#
# So exactly one package is added: guestfs-tools, for virt-cat.
#
# I spent two rounds avoiding that package by reimplementing virt-cat with
# qemu-img and debugfs, and the result was 174 lines that took over seven minutes
# to read one twenty-byte marker - because qemu-img walks a qcow2 cluster by
# cluster. That is a hundred times slower than the tool it replaced, to avoid one
# apt install that now happens once at image build instead of in every job. The
# package is "heavy" in the sense that it brings an appliance; it is not heavy in
# the sense that matters here.
#
# The package name is guestfs-tools, not libguestfs-tools. Debian split them:
# libguestfs-tools installs cleanly and gives you libguestfs-test-tool and
# nothing else, so `virt-cat --version` fails with
#
#   /bin/sh: 1: virt-cat: not found
#
# after a build that otherwise looks successful. The contents search for the path
# ending in virt-cat says guestfs-tools.
FROM qemux/qemu:7.50

# apt-get update && install - with &&, not ;.
#
# The previous version used `;` between the commands, so when the install failed
# the RUN carried on, the layer succeeded, and the failure only appeared in the
# next layer as `/bin/sh: 1: virt-cat: not found` - which reads like a wrong
# package name rather than a dependency that could not be resolved.
#
# What actually happened:
#
#   guestfs-tools 1.52.3-1 depends on libguestfs0t64 >= 1:1.54.0
#   libguestfs0t64 depends on udev
#   udev depends on libsystemd-shared (= 257.13-1~deb13u1)
#
# and apt refused because that libsystemd-shared would be a downgrade. Debian
# trixie has since moved libsystemd-shared forward, so the pin cannot be met from
# the release pocket. --allow-downgrades is the honest way to say "yes, I know";
# the alternative is a base image from a different Debian snapshot.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      --allow-downgrades \
      guestfs-tools && \
    rm -rf /var/lib/apt/lists/* && \
    virt-cat --version

# A self-check at build time, so a base image that loses one of these is caught
# here rather than twenty minutes into a bake. Everything listed is a tool the
# harness invokes directly.
RUN set -eux; \
    qemu-system-x86_64 --version | head -1; \
    qemu-img --version | head -1; \
    7z 2>/dev/null | head -2 | tail -1; \
    virt-cat --version; \
    python3 --version; \
    curl --version | head -1

# GitHub Actions runs a container job as `docker run <image> <entrypoint>`; this
# image's entrypoint starts a VM, which is not what a job wants. The workflows
# override it, but having no ENTRYPOINT here makes that impossible to get wrong.
ENTRYPOINT []
CMD ["/bin/bash"]
